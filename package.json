{
  "name": "wolfram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "preview": "vite preview",
    "gen-icons": "node scripts/gen-icons.mjs",
    "check-live": "node scripts/check-live.mjs https://seanmurray.github.io/wolfram/",
    "prepare": "git config core.hooksPath .githooks",
