    "build:native": "vite build && cap sync ios && node scripts/fix-spm-paths.mjs"
  },
  "dependencies": {
    "@capacitor/core": "7.6.7",
    "@capacitor/filesystem": "7.1.8",
    "@capacitor/ios": "7.6.7",
